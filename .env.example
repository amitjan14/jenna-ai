# Export these variables in your shell before starting Jenna.
OLLAMA_HOST=http://localhost:11434
JENNA_CHAT_MODEL=qwen3.5:9b
JENNA_ROUTER_MODEL=qwen3.5:9b
JENNA_EMBEDDING_MODEL=nomic-embed-text
JENNA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
JENNA_CANDIDATE_K=40
JENNA_CONTEXT_K=8
# Optional web search; do not commit your actual key.
TAVILY_API_KEY=
# General MCP reasoning stays local. MCP tools may contact the selected service.
JENNA_MCP_MODEL=qwen3.5:9b
JENNA_MCP_CONTEXT_TOKENS=16384
JENNA_MCP_OUTPUT_TOKENS=2048
JENNA_MCP_MAX_STEPS=10
JENNA_MCP_MAX_READS=16
# Enable longer internal reasoning when desired; can increase latency substantially.
JENNA_MCP_THINK=false
# Local engineering controls; no request content is stored in trace records.
JENNA_TRACE_RETENTION_DAYS=30
JENNA_TOOL_SCHEMA_LIMIT=8
# Layout parsing adds table extraction and local OCR. Existing indexes are
# refreshed only when the corresponding PDF is uploaded/reindexed.
JENNA_PDF_PARSER=layout
JENNA_OCR=true
# auto reads substantial embedded images, handwriting/ink and diagrams locally.
# always reads every nonblank page visually; off uses printed-text Tesseract OCR.
JENNA_PDF_VISION=auto
JENNA_VISION_MODEL=qwen3.5:9b
JENNA_CHUNKING_STRATEGY=words
# For macOS Homebrew OCR, when automatic discovery is unavailable:
# TESSDATA_PREFIX=/opt/homebrew/share/tessdata
